/.claude/settings.local.json

# Figure 2 analysis workspace (local only)
/fig2/

# scATAC bigWigs: ~7 GB of derived data, many files far over GitHub's 100 MB
# limit. These are deploy-time artifacts, not source: they are rsynced to the
# server alongside the built frontend, never committed. Regenerate the
# per-cell-type tracks with scripts/run_wang_celltype_tracks.sh.
/src/assets/tracks/scatac/*.bw
